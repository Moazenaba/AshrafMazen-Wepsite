# Copy this file to .env.local for development, and set the same names in Vercel (Settings -> Environment Variables).
# Names starting with VITE_ are public (they ship inside the site). Everything else is a secret that only the
# server functions in api/ can read: never prefix a secret with VITE_.
 
# --- Supabase: the database and admin sign-in (public values, safe in the browser) ---
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_your_anon_key"

# The server functions read the same two values without the VITE_ prefix
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_your_anon_key"

# Secret, server only: lets api/submit save visitor requests (visit ors cannot write to that table themselves).
# Supabase -> Project Settings -> API -> service_role. Never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# --- Cloudflare R2: where every uploaded file lives (recordings, books, covers, the logo) ---
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_BUCKET="your_bucket_name"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
# Optional: the bucket's public address (r2.dev or a custom domain). Leave empty to keep the bucket private;
# the site then serves files itself through /api/r2.
VITE_R2_PUBLIC_URL=""

# --- Site ---
# The public address, used for the sitemap (npm run sitemap)
SITE_URL="https://ashraf-mazen.vercel.app"

# --- Optional: Cloudflare Turnstile bot check on the "شارك" form (turned on only when both are set) ---
# Site key is public; the secret stays on the server (Vercel). Create a widget at dash.cloudflare.com -> Turnstile.
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Optional: downloads and reels (each has a working built-in value; set only to change it) ---
# Download services tried one after another (comma separated). cobalt instances may carry an API key: https://host|key
COBALT_INSTANCES="https://api.cobalt.liubquanti.click"
INVIDIOUS_INSTANCES="https://yt.chocolatemoo53.com"
PIPED_INSTANCES="https://pipedapi.kavin.rocks,https://api.piped.private.coffee"
# The sheikh's channel: reels come from it, and only its videos can be downloaded
YOUTUBE_CHANNEL_ID="UCisGvsFtKyDU6NTFywaITzQ"
YOUTUBE_CHANNEL_HANDLE="Ashrafmazen"

# --- Optional: files, search engines and the build ---
# The bucket's public address for the server functions (VITE_R2_PUBLIC_URL above is the browser's copy of the same value)
R2_PUBLIC_URL=""
# Extra site addresses the bucket's CORS rule should allow (comma separated); used by scripts/r2-setup.ts
R2_CORS_ORIGINS=""
# Search Console / Bing Webmaster verification codes, written into every prerendered page
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
# Set to 1 (after one clean deploy) to make the production build fail when the pages cannot be prerendered
PRERENDER_STRICT=""
