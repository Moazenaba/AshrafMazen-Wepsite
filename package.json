{
  "name": "sheikh-ashraf-mazen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/generate-sitemap.mjs --soft && vite build && node scripts/prerender.mjs --soft",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build",
    "health": "tsx scripts/health-check.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "r2:setup": "tsx scripts/r2-setup.ts",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "sync:youtube": "node scripts/sync-youtube.mjs",
    "build:library": "node scripts/build-youtube-library.mjs",
    "refresh:youtube": "node scripts/refresh-youtube-library.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/postgrest-js": "2.118.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "description": "الموقع الرسمي للشيخ أشرف مازن"
}
