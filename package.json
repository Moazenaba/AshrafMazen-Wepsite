{
  "name": "sheikh-ashraf-mazen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/generate-sitemap.mjs --soft && vite build && node scripts/prerender.mjs --soft",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "schema": "node scripts/dump-schema.mjs && node scripts/schema-to-sql.mjs",
    "e2e": "playwright test --project=local",
    "e2e:live": "playwright test --project=live",
    "lint": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build && node scripts/check-bundle-size.mjs && node scripts/seo-audit.mjs",
    "health": "tsx scripts/health-check.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "r2:setup": "tsx scripts/r2-setup.ts",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:live": "node scripts/seo-live.mjs",
    "og-image": "node scripts/make-og-image.mjs",
    "sync:youtube": "node scripts/sync-youtube.mjs",
    "build:library": "node scripts/build-youtube-library.mjs",
    "refresh:youtube": "node scripts/refresh-youtube-library.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@supabase/postgrest-js": "2.119.2",
    "@supabase/supabase-js": "^2.119.2",
    "@tailwindcss/vite": "^4.3.5",
    "@vercel/speed-insights": "^2.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "lucide-react": "^1.77.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.6",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "description": "الموقع الرسمي للشيخ أشرف مازن"
}
